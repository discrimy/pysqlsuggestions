{
  "name": "pysqlsuggestions",
  "displayName": "pysqlsuggestions",
  "description": "Schema-aware SQL completion: joins from foreign keys, values from statistics",
  "version": "0.9.0",
  "publisher": "pysqlsuggestions",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "pysqlsuggestions.connections",
          "name": "SQL Connections"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pysqlsuggestions.connections",
        "contents": "No database connections yet.\n[Add connection](command:pysqlsuggestions.addConnection)\nOnly PostgreSQL reads a schema in this release; the others complete from the statement."
      }
    ],
    "commands": [
      {
        "command": "pysqlsuggestions.addConnection",
        "title": "pysqlsuggestions: Add connection",
        "icon": "$(add)"
      },
      {
        "command": "pysqlsuggestions.selectConnection",
        "title": "pysqlsuggestions: Select connection for this workspace"
      },
      {
        "command": "pysqlsuggestions.restartServer",
        "title": "pysqlsuggestions: Restart server"
      },
      {
        "command": "pysqlsuggestions.showLogs",
        "title": "pysqlsuggestions: Show logs"
      },
      {
        "command": "pysqlsuggestions.refreshConnections",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "pysqlsuggestions.editConnection",
        "title": "Edit…",
        "icon": "$(edit)"
      },
      {
        "command": "pysqlsuggestions.removeConnection",
        "title": "Remove",
        "icon": "$(trash)"
      },
      {
        "command": "pysqlsuggestions.setPassword",
        "title": "Set password…"
      },
      {
        "command": "pysqlsuggestions.clearPassword",
        "title": "Clear password"
      },
      {
        "command": "pysqlsuggestions.testConnection",
        "title": "Test connection"
      },
      {
        "command": "pysqlsuggestions.useConnection",
        "title": "Use this connection"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pysqlsuggestions.addConnection",
          "when": "view == pysqlsuggestions.connections",
          "group": "navigation@1"
        },
        {
          "command": "pysqlsuggestions.refreshConnections",
          "when": "view == pysqlsuggestions.connections",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "pysqlsuggestions.editConnection",
          "when": "view == pysqlsuggestions.connections && viewItem == connection",
          "group": "inline@1"
        },
        {
          "command": "pysqlsuggestions.removeConnection",
          "when": "view == pysqlsuggestions.connections && viewItem == connection",
          "group": "inline@2"
        },
        {
          "command": "pysqlsuggestions.useConnection",
          "when": "view == pysqlsuggestions.connections && viewItem == connection",
          "group": "1_use@1"
        },
        {
          "command": "pysqlsuggestions.testConnection",
          "when": "view == pysqlsuggestions.connections && viewItem == connection",
          "group": "1_use@2"
        },
        {
          "command": "pysqlsuggestions.setPassword",
          "when": "view == pysqlsuggestions.connections && viewItem == connection",
          "group": "2_auth@1"
        },
        {
          "command": "pysqlsuggestions.clearPassword",
          "when": "view == pysqlsuggestions.connections && viewItem == connection",
          "group": "2_auth@2"
        }
      ],
      "commandPalette": [
        {
          "command": "pysqlsuggestions.refreshConnections",
          "when": "false"
        },
        {
          "command": "pysqlsuggestions.editConnection",
          "when": "false"
        },
        {
          "command": "pysqlsuggestions.removeConnection",
          "when": "false"
        },
        {
          "command": "pysqlsuggestions.setPassword",
          "when": "false"
        },
        {
          "command": "pysqlsuggestions.clearPassword",
          "when": "false"
        },
        {
          "command": "pysqlsuggestions.testConnection",
          "when": "false"
        },
        {
          "command": "pysqlsuggestions.useConnection",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "pysqlsuggestions",
      "properties": {
        "pysqlsuggestions.connections": {
          "type": "array",
          "default": [],
          "markdownDescription": "Named database connections. Passwords are **not** stored here — they are prompted for once and kept in the editor's secret storage.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "dialect",
              "host"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "What this connection is called."
              },
              "dialect": {
                "type": "string",
                "enum": [
                  "postgres",
                  "clickhouse",
                  "trino",
                  "ansi"
                ],
                "markdownDescription": "`postgres`, `clickhouse` and `trino` all read a catalog. `ansi` completes from the statement alone, with the right keywords and quoting."
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "number"
              },
              "database": {
                "type": "string"
              },
              "user": {
                "type": "string"
              },
              "secure": {
                "type": "boolean",
                "default": false,
                "description": "Speak TLS. Trino requires it before it will accept a password."
              },
              "verify": {
                "type": "boolean",
                "default": true,
                "markdownDescription": "Check the server's TLS certificate. Set `false` only for a self-signed certificate you already trust — it also stops the hostname being checked, so nothing about the endpoint's identity is verified."
              }
            },
            "additionalProperties": false
          }
        },
        "pysqlsuggestions.defaultConnection": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Which named connection to use when nothing else says otherwise."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "compile": "tsc -p . --outDir out",
    "check": "tsc --noEmit && npm run compile && node --test \"out/test/unit/*.test.js\"",
    "test:integration": "npm run compile && node out/test/runTests.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "mocha": "^10.3.0",
    "typescript": "^5.3.0"
  }
}
